# AWS Configuration
AWS_REGION=ap-south-1
# AWS_PROFILE=your-profile

# OR use access keys (not recommended for production)
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# S3 Configuration
S3_BUCKET=glycosense-models-v1
S3_PREFIX_BASE=models/indicconformer
S3_LLM_PREFIX_BASE=models/llm

# Pre-signed URL TTL (seconds)
PRESIGN_TTL_SECONDS=900

# Authentication: none to configure. rhmp-services' Envoy ext_authz sets X-User-Id (README).

# Logging Configuration
LOG_LEVEL=info                                # debug, info, warn, error
LOG_FILE_PATH=./logs/presign-api.log          # Path to log file
LOG_MAX_SIZE_MB=100                           # Max log file size in MB before rotation
LOG_MAX_BACKUPS=5                             # Number of rotated log files to keep
LOG_MAX_AGE_DAYS=30                           # Delete logs older than this many days
LOG_FORMAT=json                               # json or text
ENVIRONMENT=production                        # production, staging, development
